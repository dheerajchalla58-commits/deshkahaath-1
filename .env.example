# Keep provider secrets in .env; never put them in browser JavaScript.
# Pollinations image requests need a Secret Key plus available Pollen credit.
POLLINATIONS_API_KEY=replace_with_your_server_secret_key
POLLINATIONS_IMAGE_MODEL=black-forest-labs/flux.1.1-pro

# Alternatively, configure the existing Gemini or Hugging Face image provider.
# GEMINI_IMAGE_API_KEY=your_gemini_api_key
# HF_TOKEN=your_hugging_face_token
